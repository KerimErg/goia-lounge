# ─── Base de données PostgreSQL (Neon recommandé) ────────────────────────────
# Connexion POOLÉE (hôte contenant "-pooler") + pgbouncer=true : utilisée par le site.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"
# Connexion DIRECTE (même URL SANS "-pooler") : utilisée par les migrations (prisma migrate deploy).
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# ─── Authentification de l'équipe (NextAuth) ─────────────────────────────────
# Générez une valeur : openssl rand -base64 32 — à définir pour Production ET Preview sur Vercel.
NEXTAUTH_SECRET="change-me"
# URL publique EXACTE du site (http://localhost:3000 en local, https://www.votre-domaine.de en prod).
NEXTAUTH_URL="http://localhost:3000"

# ─── Seed (données de démonstration) ─────────────────────────────────────────
SEED_ADMIN_EMAIL="admin@goia.test"
SEED_ADMIN_PASSWORD=""
# Le seed EFFACE la base : il refuse une base distante sauf SEED_ALLOW_RESET=yes.
# SEED_ALLOW_RESET="yes"

# ─── E-mails des réservations (Resend) ───────────────────────────────────────
# Sans ces deux variables, le site fonctionne mais n'envoie aucun e-mail.
RESEND_API_KEY=""
EMAIL_FROM="GOIA Lounge <reservation@votre-domaine.de>"
# Adresse qui reçoit une copie de chaque réservation / annulation + le récapitulatif du soir.
NOTIFY_EMAIL=""

# ─── Récapitulatif quotidien + nettoyage DSGVO (Vercel Cron, voir vercel.json) ─
# Une longue valeur au hasard ; Vercel l'envoie automatiquement au cron.
CRON_SECRET=""

# ─── Seed (une seule fois, depuis votre machine) ─────────────────────────────
# SEED_NOTIFY_EMAIL="vous@exemple.de"   # enregistre l'adresse de copie dans les réglages
